# Copy this file to .env and fill in the values. Never commit .env.

# Google Gemini API key (https://aistudio.google.com/apikey). Keep it server-side only.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BACKUP_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# MongoDB (local or Atlas)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=contextbasedrag

# Private folders (kept out of git): vector index and original uploaded files
CHROMA_DIR=chroma_data
STORAGE_DIR=storage

# Only for hosts whose disk is emptied on restart (see docs/deployment.md): keep uploads in MongoDB
# and index them again at start-up. Leave as they are on your own machine.
FILE_STORE=disk
REINDEX_ON_START=false

LOGIN_EXPIRE_MINUTES=720
MAX_UPLOAD_MB=10
# Zone of times in imported breakdown logs that carry none
LOCAL_TIMEZONE=Asia/Kolkata
# true lets the author of a work order approve it (single-manager factories)
ALLOW_SELF_APPROVAL=false
# Registration fee of a new company, in rupees (0: no fee). Paid by UPI to UPI_ID; the company sends the UTR and a
# screenshot, which the AI check reads. Payments it cannot confirm wait for PLATFORM_OWNER_EMAIL on the Payments page.
REGISTRATION_FEE=2999
UPI_ID=
UPI_PAYEE_NAME=
PLATFORM_OWNER_EMAIL=

# Outgoing mail. Gmail: SMTP_USER is the Gmail address, SMTP_PASSWORD a 16-character app password
# (Google Account -> Security -> App passwords), never the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Address of this application, for the sign-in link in mails
APP_BASE_URL=http://127.0.0.1:8000

# Other browser origins allowed to call the API, comma-separated. Empty: only this server's own pages.
CORS_ORIGINS=

# Password of the four demo users created by: python -m backend.scripts.seed_demo
DEMO_PASSWORD=change-this-demo-password
